#!/bin/sh
# Chamado pelo PAM (pam_exec) logo antes do Howdy: avisa o presence-guard para
# soltar a câmera IR e espera (no máximo 2 s) ele soltar, senão o Howdy não
# consegue abrir a câmera. Nunca falha: o PAM segue normalmente de qualquer jeito.
#
# Roda como você (sudo, polkit, su) ou como root (tela de bloqueio do GNOME).
# Não lê nenhum arquivo do usuário: só encosta no arquivo de aviso dele (sem
# seguir atalhos e sem criar nada) e olha no /proc se o vigia ainda está com
# uma câmera (/dev/video*) aberta.

for f in /run/user/*/presence-guard/yield; do
    [ -f "$f" ] && [ ! -L "$f" ] && /usr/bin/touch -c -h "$f" 2>/dev/null
done

camera_busy() {
    for pid in $(/usr/bin/pgrep -f presence_guard.py 2>/dev/null); do
        for fd in /proc/"$pid"/fd/*; do
            case "$(/usr/bin/readlink "$fd" 2>/dev/null)" in
                /dev/video*) return 0 ;;
            esac
        done
    done
    return 1
}

i=0
while camera_busy && [ "$i" -lt 25 ]; do
    /usr/bin/sleep 0.05
    i=$((i + 1))
done
exit 0
