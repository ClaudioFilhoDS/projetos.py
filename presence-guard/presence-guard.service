[Unit]
Description=Presence Guard - bloqueia/borra a tela usando a camera IR
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/share/presence-guard/venv/bin/python %h/.local/share/presence-guard/presence_guard.py run
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# vigia de fundo: cede a vez para os seus programas
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=graphical-session.target
